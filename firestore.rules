rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if caller owns the operator namespace
    function isOwner(operatorId) {
      return isAuthenticated() && request.auth.uid == operatorId;
    }

    // Operator Profile Document
    match /users/{operatorId} {
      allow read, write: if isOwner(operatorId);

      // Areas Subcollection
      match /areas/{areaId} {
        allow read, write: if isOwner(operatorId);
      }

      // Customers Subcollection
      match /customers/{customerId} {
        allow read, write: if isOwner(operatorId);

        // Recharges Subcollection
        match /recharges/{rechargeId} {
          allow read, write: if isOwner(operatorId);
        }
      }

      // Reports Subcollection (Aggregated Monthly Analytics)
      match /reports/{reportId} {
        allow read, write: if isOwner(operatorId);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
